// Local Jenkins-in-Docker setup:
// - Mount host Docker socket: -v /var/run/docker.sock:/var/run/docker.sock
// - Install plugins: Docker Pipeline, Pipeline
// - Optional: map a stable port (default 9080) so the UI is reachable on your machine

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        IMAGE_NAME = 'project-frontend'
        LOCAL_PORT = "${env.FRONTEND_LOCAL_PORT ?: '9080'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependency Build') {
            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u root'
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci && npm run build'
                }
            }
        }

        stage('Docker Image Build') {
            agent {
                docker {
                    image 'docker:24-cli'
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    dir('frontend') {
                        sh "docker build -t ${tag} ."
                        sh "docker tag ${tag} ${IMAGE_NAME}:latest"
                        if (env.DOCKER_REGISTRY?.trim()) {
                            def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                            sh """
                                docker tag ${tag} ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                                docker tag ${tag} ${reg}/${IMAGE_NAME}:latest
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            agent {
                docker {
                    image 'docker:24-cli'
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker push ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${reg}/${IMAGE_NAME}:latest
                        """
                    } else {
                        sh """
                            docker stop project-frontend-local 2>/dev/null || true
                            docker rm project-frontend-local 2>/dev/null || true
                            docker run -d --name project-frontend-local -p ${LOCAL_PORT}:80 ${tag}
                        """
                        echo "Frontend (nginx) published on host port ${LOCAL_PORT} (http://localhost:${LOCAL_PORT})"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo 'Frontend pipeline failed — check stages above.'
        }
    }
}
