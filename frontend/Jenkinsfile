// agent any + docker CLI (no "Docker Pipeline" plugin required).
// Official jenkins/jenkins has NO docker binary — use repo jenkins/Dockerfile + jenkins/compose.yaml.
// Optional: FRONTEND_LOCAL_PORT (default 9080), WORKSPACE_HOST_PATH if volume mounts fail.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        IMAGE_NAME = 'project-frontend'
        LOCAL_PORT = "${env.FRONTEND_LOCAL_PORT ?: '9080'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Docker') {
            steps {
                sh '''
                    if ! command -v docker >/dev/null 2>&1; then
                        echo "docker CLI not found inside Jenkins."
                        echo "Fix: build and run from repo jenkins/ (Dockerfile + compose.yaml), or apt-get install docker.io in your image."
                        exit 1
                    fi
                    if ! docker info >/dev/null 2>&1; then
                        echo "docker cannot reach the daemon. Mount /var/run/docker.sock and fix permissions (jenkins/compose.yaml group_add)."
                        exit 1
                    fi
                '''
            }
        }

        stage('Dependency Build') {
            steps {
                script {
                    def wsMount = env.WORKSPACE_HOST_PATH?.trim() ? env.WORKSPACE_HOST_PATH.trim() : env.WORKSPACE
                    sh """
                        docker run --rm \\
                          -v "${wsMount}:/ws" \\
                          -w /ws/frontend \\
                          node:20-alpine \\
                          sh -ce "npm ci && npm run build"
                    """
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    def wsMount = env.WORKSPACE_HOST_PATH?.trim() ? env.WORKSPACE_HOST_PATH.trim() : env.WORKSPACE
                    sh """
                        docker build -t ${tag} -f "${wsMount}/frontend/Dockerfile" "${wsMount}/frontend"
                        docker tag ${tag} ${IMAGE_NAME}:latest
                    """
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker tag ${tag} ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker tag ${tag} ${reg}/${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker push ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${reg}/${IMAGE_NAME}:latest
                        """
                    } else {
                        sh """
                            docker stop project-frontend-local 2>/dev/null || true
                            docker rm project-frontend-local 2>/dev/null || true
                            docker run -d --name project-frontend-local -p ${LOCAL_PORT}:80 ${tag}
                        """
                        echo "Frontend (nginx) on http://localhost:${LOCAL_PORT}"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo 'Frontend pipeline failed — check stages above.'
        }
    }
}
