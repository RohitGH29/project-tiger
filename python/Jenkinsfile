// Local Jenkins-in-Docker setup:
// - Mount host Docker socket: -v /var/run/docker.sock:/var/run/docker.sock
// - Install plugins: Docker Pipeline, Pipeline

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        IMAGE_NAME = 'project-python'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependency Build') {
            agent {
                docker {
                    image 'python:3.12-slim-bookworm'
                    args '-u root'
                }
            }
            steps {
                dir('python') {
                    sh '''
                        pip install --no-cache-dir --upgrade pip
                        pip install --no-cache-dir -r requirements.txt
                        python -m py_compile app.py
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            agent {
                docker {
                    image 'docker:24-cli'
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    dir('python') {
                        sh "docker build -t ${tag} ."
                        sh "docker tag ${tag} ${IMAGE_NAME}:latest"
                        if (env.DOCKER_REGISTRY?.trim()) {
                            def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                            sh """
                                docker tag ${tag} ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                                docker tag ${tag} ${reg}/${IMAGE_NAME}:latest
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            agent {
                docker {
                    image 'docker:24-cli'
                    args '-v /var/run/docker.sock:/var/run/docker.sock'
                }
            }
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker push ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${reg}/${IMAGE_NAME}:latest
                        """
                    } else {
                        // App exits after one HTTP call; --rm cleans up. Needs outbound HTTPS to httpbin.
                        sh "docker run --rm --name project-python-run ${tag}"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo 'Python pipeline failed — check stages above.'
        }
    }
}
