pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
        IMAGE_NAME = 'project-python'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependency Build') {
            steps {
                dir('python') {
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/python -m pip install --upgrade pip
                        ./venv/bin/python -m pip install --no-cache-dir -r requirements.txt
                        ./venv/bin/python -m py_compile app.py
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('python') {
                    sh "docker build -t ${env.IMAGE_NAME}:${env.BUILD_NUMBER} ."
                    sh "docker tag ${env.IMAGE_NAME}:${env.BUILD_NUMBER} ${env.IMAGE_NAME}:latest"
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def tag = "${env.IMAGE_NAME}:${env.BUILD_NUMBER}"
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker tag ${tag} ${reg}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}
                            docker tag ${tag} ${reg}/${env.IMAGE_NAME}:latest
                            docker push ${reg}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}
                            docker push ${reg}/${env.IMAGE_NAME}:latest
                        """
                    } else {
                        sh "docker run --rm ${tag}"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo 'Python pipeline failed — check stages above.'
        }
    }
}
