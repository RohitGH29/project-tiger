pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds(abortPrevious: true)
    }

    environment {
        DOCKER_REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        IMAGE_NAME = 'project-python'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependency Build') {
            steps {
                dir('python') {
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/python -m pip install --upgrade pip
                        ./venv/bin/python -m pip install --no-cache-dir -r requirements.txt
                        ./venv/bin/python -m py_compile app.py
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    def pyDir = fileExists('python/requirements.txt') ? "${env.WORKSPACE}/python" : (fileExists('requirements.txt') ? env.WORKSPACE : null)
                    if (!pyDir) {
                        error('No Python app found: add python/requirements.txt or requirements.txt at workspace root.')
                    }
                    sh """
                        tar -cf - \\
                          --exclude=.git \\
                          --exclude=.venv \\
                          --exclude=venv \\
                          --exclude=__pycache__ \\
                          --exclude=.ci-bin \\
                          --exclude='*.pyc' \\
                          -C "${pyDir}" . \\
                          | docker build -t ${tag} -
                        docker tag ${tag} ${IMAGE_NAME}:latest
                    """
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker tag ${tag} ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker tag ${tag} ${reg}/${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def tag = "${IMAGE_NAME}:${IMAGE_TAG}"
                    if (env.DOCKER_REGISTRY?.trim()) {
                        def reg = env.DOCKER_REGISTRY.trim().replaceAll('/$', '')
                        sh """
                            docker push ${reg}/${IMAGE_NAME}:${IMAGE_TAG}
                            docker push ${reg}/${IMAGE_NAME}:latest
                        """
                    } else {
                        sh "docker run --rm ${tag}"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo 'Python pipeline failed — check stages above.'
        }
    }
}
